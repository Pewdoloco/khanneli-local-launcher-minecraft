<Application x:Class="VanillaLauncher.Client.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VanillaLauncher.Client.UI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Тема — первая: Styles.xaml ссылается на её ключи через DynamicResource.
                     ThemeManager подменяет эту запись целиком при переключении темы (см.
                     ThemeManager.cs) — стартовый выбор здесь чисто дефолт на случай, если
                     что-то отрисуется до первого вызова ThemeManager.Apply в App.OnStartup. -->
                <ResourceDictionary Source="Theme.Light.xaml" />
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
