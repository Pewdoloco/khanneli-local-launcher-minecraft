<Window x:Class="VanillaLauncher.Client.UI.ClientSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VanillaLauncher.Client.UI"
        xmlns:loc="clr-namespace:VanillaLauncher.Client.UI.Localization"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClientSetup.Title]}" Height="560" Width="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClientSetup.Intro]}" />

        <TextBlock Grid.Row="1" FontWeight="Bold" Margin="0,0,0,4"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClientSetup.OwnerLabel]}" />
        <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClientSetup.OwnerHint]}" />
        <TextBox x:Name="GitHubOwnerTextBox" Grid.Row="3" Padding="4" Margin="0,0,0,12"
                 local:Watermark.Hint="MyName" />

        <TextBlock Grid.Row="4" FontWeight="Bold" Margin="0,0,0,4"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClientSetup.RepoLabel]}" />
        <TextBlock Grid.Row="5" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClientSetup.RepoHint]}" />
        <TextBox x:Name="GitHubRepoTextBox" Grid.Row="6" Padding="4" Margin="0,0,0,12"
                 local:Watermark.Hint="MyModpack-server" />

        <TextBlock Grid.Row="7" FontWeight="Bold" Margin="0,0,0,4"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClientSetup.FolderNameLabel]}" />
        <TextBlock Grid.Row="8" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClientSetup.FolderNameHint]}" />
        <TextBox x:Name="ClientFolderNameTextBox" Grid.Row="9" Padding="4" Margin="0,0,0,8"
                 local:Watermark.Hint="MyModpack" />

        <TextBlock x:Name="ErrorText" Grid.Row="10" Foreground="Red" TextWrapping="Wrap"
                    VerticalAlignment="Top" Visibility="Collapsed" />

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Padding="12,6" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click"
                    Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Common.Cancel]}" />
            <Button Padding="12,6" IsDefault="True" Click="SaveButton_Click" Style="{StaticResource AccentButton}"
                    Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Common.Save]}" />
        </StackPanel>
    </Grid>
</Window>
