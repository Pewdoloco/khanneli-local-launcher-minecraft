<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Цветовые токены светлой темы (значения — прежние из Styles.xaml до её разделения на
      структуру/шаблоны и цвета, engine-v1.21.0). ThemeManager.Apply меняет, какой из
      Theme.Light.xaml/Theme.Dark.xaml подключён в Application.Resources.MergedDictionaries —
      Styles.xaml ссылается на эти ключи через DynamicResource, поэтому переключение темы
      обновляет уже открытые окна мгновенно, без перезапуска (тот же принцип, что у переключателя
      языка, но проще: DynamicResource не требует своего INotifyPropertyChanged).
    -->

    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4FD1</Color>
    <Color x:Key="AccentPressedColor">#1741B0</Color>
    <Color x:Key="WindowBackgroundColor">#F5F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D9D9DE</Color>
    <Color x:Key="BorderHoverColor">#B8B8C0</Color>
    <Color x:Key="TextColor">#1D1D1F</Color>
    <Color x:Key="MutedTextColor">#6E6E73</Color>
    <Color x:Key="ButtonFaceColor">#ECECEE</Color>
    <Color x:Key="ButtonFaceHoverColor">#E2E2E6</Color>
    <Color x:Key="ButtonFacePressedColor">#D6D6DC</Color>
    <Color x:Key="GhostHoverColor">#E9E9EC</Color>
    <Color x:Key="ScrollBarThumbColor">#C7C7CC</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#B0B0B6</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="ButtonFaceBrush" Color="{StaticResource ButtonFaceColor}" />
    <SolidColorBrush x:Key="ButtonFaceHoverBrush" Color="{StaticResource ButtonFaceHoverColor}" />
    <SolidColorBrush x:Key="ButtonFacePressedBrush" Color="{StaticResource ButtonFacePressedColor}" />
    <SolidColorBrush x:Key="GhostHoverBrush" Color="{StaticResource GhostHoverColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E8E3E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D93025" />

</ResourceDictionary>
